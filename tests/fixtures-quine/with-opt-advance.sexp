(:user "Hello" :thinking "Testing opt-advance" :assistant "OK" :current-focus "" :theory-of-mind "" :self-narrative "" :annotation "" :opt-advance (defun advance (prev args timestamp) (let ((turn-id (1+ (or (cdr (assoc :turn-id prev)) 0)))) (list (cons :_schema (copy-tree *affordance*)) (cons :turn-id turn-id) (cons :timestamp timestamp) (cons :layers (list (cons :user (getf args :user)) (cons :thinking (getf args :thinking)) (cons :assistant (getf args :assistant)))) (cons :current-focus (getf args :current-focus)) (cons :theory-of-mind (getf args :theory-of-mind)) (cons :self-narrative (getf args :self-narrative)) (cons :annotation (getf args :annotation)) (cons :opt-advance-marker "present")))))
